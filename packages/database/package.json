{
  "name": "@zyvo/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate --config=prisma.config.ts && tsc",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate --config=prisma.config.ts",
    "db:push": "prisma db push --config=prisma.config.ts",
    "db:migrate": "prisma migrate dev --config=prisma.config.ts",
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@zyvo/typescript-config": "workspace:*",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
