model PricingRule {
  id                   String   @id @default(uuid()) @db.Uuid
  category             String   @unique @db.VarChar(30)
  baseFarePaise        Int      @map("base_fare_paise")
  perKmRatePaise       Int      @map("per_km_rate_paise")
  perMinuteRatePaise   Int      @map("per_minute_rate_paise")
  minimumFarePaise     Int      @map("minimum_fare_paise")
  cancellationFeePaise Int      @map("cancellation_fee_paise")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("pricing_rules")
  @@schema("pricing")
}

model FareEstimate {
  id              String   @id @default(uuid()) @db.Uuid
  category        String   @db.VarChar(30)
  distanceMeters  Int      @map("distance_meters")
  durationSeconds Int      @map("duration_seconds")
  baseFarePaise   Int      @map("base_fare_paise")
  distanceFarePaise Int    @map("distance_fare_paise")
  timeFarePaise   Int      @map("time_fare_paise")
  surgeMultiplier Decimal  @default(1.00) @map("surge_multiplier") @db.Decimal(4, 2)
  totalFarePaise  Int      @map("total_fare_paise")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("fare_estimates")
  @@schema("pricing")
}

model SurgeZone {
  id          String   @id @default(uuid()) @db.Uuid
  zoneName    String   @map("zone_name") @db.VarChar(100)
  multiplier  Decimal  @default(1.00) @db.Decimal(4, 2)
  boundaryGeo Json     @map("boundary_geo")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("surge_zones")
  @@schema("pricing")
}
