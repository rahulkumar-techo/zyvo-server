model Trip {
  id                 String    @id @default(uuid()) @db.Uuid
  passengerId        String    @map("passenger_id") @db.Uuid
  driverId           String?   @map("driver_id") @db.Uuid
  vehicleId          String?   @map("vehicle_id") @db.Uuid
  status             String    @default("requested") @db.VarChar(30)
  pickupAddress      String    @map("pickup_address") @db.Text
  pickupLat          Decimal   @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng          Decimal   @map("pickup_lng") @db.Decimal(10, 7)
  dropoffAddress     String    @map("dropoff_address") @db.Text
  dropoffLat         Decimal   @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng         Decimal   @map("dropoff_lng") @db.Decimal(10, 7)
  distanceMeters     Int       @map("distance_meters")
  durationSeconds    Int       @map("duration_seconds")
  estimatedFarePaise Int       @map("estimated_fare_paise")
  actualFarePaise    Int?      @map("actual_fare_paise")
  surgeMultiplier    Decimal   @default(1.00) @map("surge_multiplier") @db.Decimal(4, 2)
  idempotencyKey     String?   @unique @map("idempotency_key") @db.VarChar(100)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  events             TripEvent[]
  offers             RideOffer[]

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@map("trips")
  @@schema("trips")
}

model TripEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  fromState String?  @map("from_state") @db.VarChar(30)
  toState   String   @map("to_state") @db.VarChar(30)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_events")
  @@schema("trips")
}

model RideOffer {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  status    String   @default("pending") @db.VarChar(20)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([driverId])
  @@index([status])
  @@map("ride_offers")
  @@schema("trips")
}
