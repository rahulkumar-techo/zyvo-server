# Environment Configuration Template
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=zyvo-super-secret-jwt-key-change-in-production

# Database Connections
DATABASE_URL="postgresql://postgres:root@localhost:5432/zyvo"
DATABASE_URL_DEV="postgresql://postgres:root@localhost:5432/zyvo"
DATABASE_URL_PROD="postgresql://postgres:user:password@cloud-host:5432/zyvo?sslmode=require"

# Internal Service Upstreams
AUTH_SERVICE_URL="http://localhost:4001"
USERS_SERVICE_URL="http://localhost:4002"
DRIVERS_SERVICE_URL="http://localhost:4003"
PRICING_SERVICE_URL="http://localhost:4004"
RIDES_SERVICE_URL="http://localhost:4005"
PAYMENTS_SERVICE_URL="http://localhost:4006"
NOTIFICATIONS_SERVICE_URL="http://localhost:4007"
