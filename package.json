{
  "name": "zyvo-server",
  "version": "1.0.0",
  "description": "Zyvo microservices monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:gateway": "pnpm --filter @zyvo/api-gateway dev",
